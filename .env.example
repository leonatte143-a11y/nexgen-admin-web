# NEXGEN Admin Web — copy to .env.local (dev) or set in Vercel → Environment Variables
# Origin only — /api/v1 is appended automatically by the API client.
VITE_API_BASE_URL=http://localhost:4000

# Production example (Vercel):
# VITE_API_BASE_URL=https://nexgen-backend-production.up.railway.app

# Optional — Google Maps (Geo + Live Monitor pages):
# VITE_GOOGLE_MAPS_KEY=
